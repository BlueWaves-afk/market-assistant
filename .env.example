# Local demo settings. Copy this file to .env; keep all secrets out of source control.
APP_ENV=development
DEMO_MODE=true
DEMO_OWNER_ID=demo-investor
DATABASE_PATH=.local/market-partner.sqlite3
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
MCP_URL=http://127.0.0.1:8000/mcp

# Amazon Bedrock is optional. Use the AWS SDK credential chain; do not put AWS keys here.
BEDROCK_ENABLED=false
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=1200

# Sarvam model access for conversational routing and the evidence-analysis graph.
SARVAM_ENABLED=false
SARVAM_API_KEY=
SARVAM_MODEL_ID=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_MAX_TOKENS=1200
SARVAM_TIMEOUT_SECONDS=60

# Upstox stays disabled until the sandbox instrument mapping and API behavior are verified.
UPSTOX_SANDBOX_ENABLED=false
UPSTOX_SANDBOX_VERIFIED=false
UPSTOX_SANDBOX_BASE_URL=https://sandbox.upstox.com
UPSTOX_SANDBOX_TOKEN=

# Read-only account linking stays disabled until application approval, OAuth and ownership controls exist.
SNAPTRADE_ENABLED=false
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
